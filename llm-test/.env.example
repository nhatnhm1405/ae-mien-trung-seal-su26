# Copy file này thành .env rồi điền giá trị thật (.env đã bị .gitignore chặn,
# KHÔNG BAO GIỜ commit .env thật lên git).

# Địa chỉ broker MQTT của BTC — điền khi tìm được host:port thật.
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883

# Lấy từ card MQTT_CREDENTIALS trên trang BTC
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TEST_KEY=
MQTT_TEST_TOPIC=

# false = tắt simulator, dùng broker thật
SIMULATE=true

# LLM (DeepSeek qua OpenAI-compatible SDK) — dùng cho Coordinator & Action Agent.
# DeepSeek dùng chung OpenAI Python SDK, chỉ khác base_url + tên model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
